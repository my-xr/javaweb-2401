<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gzu.ctts.mapper.UserMapper">

    <resultMap id="userMap" type="com.gzu.ctts.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="realName" column="real_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>

        <collection property="roles" ofType="com.gzu.ctts.entity.Role">
            <id column="role_id" property="id"/>
            <result column="role_code" property="roleCode"/>
            <result column="role_name" property="roleName"/>
            <result column="description" property="description"/>
            <result column="role_status" property="status"/>
        </collection>
    </resultMap>

    <sql id="userColumns">
        id, username, password, real_name, email, phone, status, create_time, update_time
    </sql>

    <select id="selectById" resultMap="userMap">
        SELECT
        <include refid="userColumns"/>
        FROM sys_user WHERE id = #{id}
    </select>

    <select id="selectByIdWithRoles" resultMap="userMap">
        SELECT
        user.id,
        user.username,
        user.PASSWORD,
        user.real_name,
        user.email,
        user.phone,
        user.STATUS,
        user.create_time,
        user.update_time,
        role.id AS role_id,
        role.role_code,
        role.role_name
        FROM
        sys_user user
        LEFT JOIN sys_user_role ur ON user.id = ur.user_id
        LEFT JOIN sys_role role ON ur.role_id = role.id
        WHERE
        user.id = #{id}
    </select>

    <select id="selectPageWithRoles" resultMap="userMap">
        SELECT
        user.id,
        user.username,
        user.PASSWORD,
        user.real_name,
        user.email,
        user.phone,
        user.STATUS,
        user.create_time,
        user.update_time,
        role.id AS role_id,
        role.role_code,
        role.role_name
        FROM
        sys_user user
        LEFT JOIN sys_user_role ur ON user.id = ur.user_id
        LEFT JOIN sys_role role ON ur.role_id = role.id
    </select>

    <select id="selectPage" resultMap="userMap">
        SELECT
        <include refid="userColumns"/>
        FROM sys_user
    </select>

</mapper>